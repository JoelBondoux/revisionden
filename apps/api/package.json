{
  "name": "@revisionden/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API on Cloudflare Workers (Hono).",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "check:bundle": "wrangler deploy --dry-run --env production --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@neondatabase/serverless": "^1.2.1",
    "@revisionden/core": "workspace:*",
    "@revisionden/db": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.8",
    "smol-toml": "^1.9.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.168.0"
  }
}
