{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoelBondoux/revisionden/content/schemas/subject.schema.json",
  "title": "Subject",
  "type": "object",
  "required": ["id", "name", "level", "boards"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "level": { "enum": ["GCSE", "A-Level"] },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["board", "spec_code"],
        "properties": {
          "board": { "$ref": "#/$defs/id" },
          "spec_code": { "type": "string", "minLength": 1 },
          "tiers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["foundation", "higher"] }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
