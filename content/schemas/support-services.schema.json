{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revisionden.com/schemas/support-services.schema.json",
  "title": "UK support services for the Get help page",
  "description": "Every contact detail, opening time and age range carries the URL of the service's own official page it was copied from. See docs/PRODUCT_RULES.md (Get help).",
  "type": "object",
  "additionalProperties": false,
  "required": ["about", "topics", "services"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "intro", "urgent"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "intro": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "urgent": {
            "type": "boolean"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "description": "The official page this detail was copied from.",
      "type": "string",
      "pattern": "^https://"
    },
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "service",
        "audiences",
        "topics",
        "helps_with",
        "official_domains",
        "contacts",
        "checked_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["student", "parent"]
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "helps_with": {
          "description": "One plain sentence in our own words (not quoted from the service).",
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "official_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]+$"
          }
        },
        "age_range": {
          "$ref": "#/$defs/sourcedText"
        },
        "area": {
          "$ref": "#/$defs/sourcedText"
        },
        "contacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confirmed_by": {
          "description": "Who confirmed the details on the official site, when not the build session (for example the product owner, checking by hand).",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "note": {
          "description": "A short extra note shown with the service. Only allowed with confirmed_by: it is not backed by a source the build session saw.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "contact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "number", "href", "source"],
          "properties": {
            "kind": {
              "const": "phone"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "pattern": "^tel:"
            },
            "hours": {
              "$ref": "#/$defs/sourcedText"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "number", "href", "source"],
          "properties": {
            "kind": {
              "const": "text"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "string",
              "minLength": 1
            },
            "keyword": {
              "type": "string",
              "pattern": "^[A-Z0-9]+$"
            },
            "href": {
              "type": "string",
              "pattern": "^sms:"
            },
            "hours": {
              "$ref": "#/$defs/sourcedText"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "number", "href", "source"],
          "properties": {
            "kind": {
              "const": "whatsapp"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "pattern": "^https://wa\\.me/"
            },
            "hours": {
              "$ref": "#/$defs/sourcedText"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "address", "href", "source"],
          "properties": {
            "kind": {
              "const": "email"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "string",
              "pattern": "^[^@\\s]+@[a-z0-9.-]+\\.[a-z]+$"
            },
            "href": {
              "type": "string",
              "pattern": "^mailto:"
            },
            "hours": {
              "$ref": "#/$defs/sourcedText"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "source"],
          "properties": {
            "kind": {
              "enum": ["web_chat", "website"]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "hours": {
              "$ref": "#/$defs/sourcedText"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      ]
    }
  }
}
