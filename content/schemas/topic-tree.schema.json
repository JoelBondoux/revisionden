{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoelBondoux/revisionden/content/schemas/topic-tree.schema.json",
  "title": "Topic tree",
  "description": "Topics for one subject, board and tier, at most three levels deep. Every leaf has a specification reference.",
  "type": "object",
  "required": ["id", "subject", "board", "specification", "topics"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "subject": { "$ref": "#/$defs/id", "description": "Id of a subject in content/subjects/." },
    "board": { "$ref": "#/$defs/id" },
    "tier": { "enum": ["foundation", "higher"] },
    "specification": {
      "type": "object",
      "required": ["code", "title", "url"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" },
    "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level1" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "leaf": {
      "type": "object",
      "required": ["id", "title", "spec_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "spec_ref": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Specification content references, for example A18."
        },
        "higher_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "level3": { "$ref": "#/$defs/leaf" },
    "level2": {
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "required": ["id", "title", "children"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "title": { "$ref": "#/$defs/title" },
            "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level3" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "level1": {
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "required": ["id", "title", "children"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "title": { "$ref": "#/$defs/title" },
            "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level2" } }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
