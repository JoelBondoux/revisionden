{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoelBondoux/revisionden/content/schemas/item.schema.json",
  "title": "Question bank item",
  "description": "One item. Item files in content/items/ hold a JSON array of these.",
  "type": "object",
  "required": [
    "id",
    "type",
    "topic",
    "difficulty",
    "source_ref",
    "checked_by",
    "citations",
    "verification"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "enum": [
        "multiple_choice",
        "short_answer",
        "numeric",
        "worked_maths",
        "flashcard",
        "extended_answer"
      ]
    },
    "topic": {
      "$ref": "#/$defs/id",
      "description": "Id of a leaf topic in a topic tree."
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "learning_point": {
      "$ref": "#/$defs/id",
      "description": "Optional finer skill within the topic, e.g. gcse-maths-h-n7-lp-fractional-indices. After a wrong answer the app offers another item with the same learning point (at least 3 per learning point); without one it falls back to the topic."
    },
    "expected_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 900,
      "description": "Optional time a confident student takes. Answers slower than twice this count as shaky. Without it the app uses a guide by item type."
    },
    "template": {
      "type": "object",
      "required": ["id", "version", "seed"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "Items made by a maths template (services/maths/app/templates, docs/TEMPLATES.md): the template, its version and the seed that remakes this item. Generated by pnpm content:templates; never edit by hand."
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Specification point or mark scheme this item is built from."
    },
    "checked_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["maths-engine", "model-b", "human", "author"]
      },
      "description": "How the item was checked. maths-engine: answer verified by services/maths; model-b: a second AI model agreed; human: a person reviewed it; author: only the writing session checked it (needs model-b or human before release). Maths items must include maths-engine."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hint": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "mark_scheme": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Short inline mark scheme, one mark point per entry."
    },
    "mark_scheme_ref": {
      "$ref": "#/$defs/id",
      "description": "Id of a mark scheme file."
    },
    "citations": {
      "$ref": "common.schema.json#/$defs/citations"
    },
    "verification": {
      "$ref": "common.schema.json#/$defs/verification"
    },
    "needs_human_approval": {
      "type": "boolean",
      "description": "Must be true when every citation is other_authoritative."
    },
    "diagram_ref": {
      "$ref": "#/$defs/id",
      "description": "Id of a diagram in content/diagrams/."
    },
    "exact": {
      "type": "object",
      "minProperties": 1,
      "description": "Facts the exact checkers verify (docs/VERIFICATION.md step 5, pnpm content:exact-check). Verified items need a passing check for each fact given.",
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1,
          "description": "The quantity the answer measures (for example area, speed, energy); its answer.unit must have that dimension. Check: units."
        },
        "chemical_equation": {
          "type": "string",
          "minLength": 3,
          "description": "A chemical equation the item states or expects; atoms and charge must balance in lowest terms. Check: chemical-equation."
        },
        "allow_fractions": {
          "type": "boolean",
          "description": "Allow fractional coefficients (such as 1/2 O2) in chemical_equation."
        },
        "equation_sheet": {
          "type": "object",
          "required": ["sheet", "equation"],
          "properties": {
            "sheet": {
              "$ref": "#/$defs/id"
            },
            "equation": {
              "$ref": "#/$defs/id"
            },
            "as_written": {
              "type": "string",
              "minLength": 3,
              "description": "The equation as the item writes it; must be equivalent to the sheet's."
            }
          },
          "additionalProperties": false,
          "description": "An equation from a verified equation sheet in content/equation-sheets/. Check: equation-sheet."
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "description": "Standard maths facts the item rests on that no cited source states (decision 0009). Each goes through the fact-check stage (pnpm content:model-check --fact-check): an official citation, or a maths engine proof plus a blind statement by a third provider.",
      "items": {
        "type": "object",
        "required": ["statement", "ask"],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "$ref": "#/$defs/text",
            "description": "The fact in plain words, as the item relies on it."
          },
          "ask": {
            "$ref": "#/$defs/text",
            "description": "A neutral question whose answer is the fact, for the blind statement (never our wording)."
          },
          "engine": {
            "type": "object",
            "required": ["kind"],
            "description": "Optional maths engine check that proves the fact (services/maths app/content_check.py and app/facts.py; fields per kind in docs/VERIFICATION.md step 4b). For example {\"kind\": \"transformation\", \"graph\": \"f(x - a)\", \"image\": \"(x + a, y)\"}.",
            "properties": {
              "kind": {
                "enum": [
                  "identity",
                  "value",
                  "solve",
                  "expression",
                  "formula",
                  "transformation",
                  "implication",
                  "sign_change",
                  "parallel",
                  "trig_value",
                  "graph_measure"
                ]
              }
            }
          },
          "citation": {
            "type": "integer",
            "minimum": 1,
            "description": "Citation number (counting from 1) whose official quote states the fact."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "$ref": "#/$defs/isType/multiple_choice"
      },
      "then": {
        "$ref": "#/$defs/multiple_choice"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/isType/short_answer"
      },
      "then": {
        "$ref": "#/$defs/short_answer"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/isType/numeric"
      },
      "then": {
        "$ref": "#/$defs/numeric"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/isType/worked_maths"
      },
      "then": {
        "$ref": "#/$defs/worked_maths"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/isType/flashcard"
      },
      "then": {
        "$ref": "#/$defs/flashcard"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/isType/extended_answer"
      },
      "then": {
        "$ref": "#/$defs/extended_answer"
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "maths": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "answer_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "What the answer is the value of, such as t or f^-1(x): an answer written \"<subject> = ...\" is read as its right-hand side."
    },
    "marks": {
      "type": "integer",
      "minimum": 1
    },
    "isType": {
      "multiple_choice": {
        "properties": {
          "type": {
            "const": "multiple_choice"
          }
        }
      },
      "short_answer": {
        "properties": {
          "type": {
            "const": "short_answer"
          }
        }
      },
      "numeric": {
        "properties": {
          "type": {
            "const": "numeric"
          }
        }
      },
      "worked_maths": {
        "properties": {
          "type": {
            "const": "worked_maths"
          }
        }
      },
      "flashcard": {
        "properties": {
          "type": {
            "const": "flashcard"
          }
        }
      },
      "extended_answer": {
        "properties": {
          "type": {
            "const": "extended_answer"
          }
        }
      }
    },
    "multiple_choice": {
      "required": ["prompt", "options", "answer", "marks"],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "answer": {
          "type": "object",
          "required": ["option"],
          "properties": {
            "option": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Zero-based index of the correct option."
        },
        "marks": {
          "$ref": "#/$defs/marks"
        }
      }
    },
    "short_answer": {
      "required": ["prompt", "answer", "marks"],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "type": "object",
          "required": ["accepted"],
          "properties": {
            "accepted": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "any_order": {
              "type": "boolean",
              "description": "Order does not matter: products and sums in any order, a list of values in any order, an equation either way round. Coordinates and inequalities are never reordered."
            },
            "units": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              },
              "description": "Units the answer may end with, or leave off (for example cm)."
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "$ref": "#/$defs/marks"
        }
      }
    },
    "numeric": {
      "required": ["prompt", "answer", "verify", "marks"],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": {
              "$ref": "#/$defs/maths"
            },
            "unit": {
              "$ref": "#/$defs/text"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "decimal_places": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "The question asks for this many decimal places: only an answer written to exactly this accuracy, with the correctly rounded value, is right."
            },
            "significant_figures": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15,
              "description": "The question asks for this many significant figures: only an answer written to this accuracy, with the correctly rounded value, is right."
            },
            "subject": {
              "$ref": "#/$defs/answer_subject"
            }
          },
          "not": {
            "anyOf": [
              { "required": ["decimal_places", "significant_figures"] },
              { "required": ["tolerance", "decimal_places"] },
              { "required": ["tolerance", "significant_figures"] }
            ]
          },
          "additionalProperties": false
        },
        "verify": {
          "type": "object",
          "required": ["expression"],
          "properties": {
            "expression": {
              "$ref": "#/$defs/maths"
            }
          },
          "additionalProperties": false,
          "description": "Calculation the maths engine evaluates and compares with answer.value."
        },
        "marks": {
          "$ref": "#/$defs/marks"
        }
      }
    },
    "worked_maths": {
      "required": ["prompt", "answer", "verify", "marks"],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "oneOf": [
            {
              "type": "object",
              "required": ["solutions"],
              "properties": {
                "solutions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/maths"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["expression"],
              "properties": {
                "expression": {
                  "$ref": "#/$defs/maths"
                },
                "subject": {
                  "$ref": "#/$defs/answer_subject"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "verify": {
          "oneOf": [
            {
              "type": "object",
              "required": ["method", "equation"],
              "properties": {
                "method": {
                  "const": "solve"
                },
                "equation": {
                  "$ref": "#/$defs/maths"
                },
                "variable": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["method", "expression"],
              "properties": {
                "method": {
                  "const": "expression"
                },
                "expression": {
                  "$ref": "#/$defs/maths"
                },
                "form": {
                  "enum": ["factorised", "expanded"]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/maths"
          },
          "description": "Model solution as lines of working; each line is checked by the engine."
        },
        "marks": {
          "$ref": "#/$defs/marks"
        }
      }
    },
    "flashcard": {
      "required": ["front", "back"],
      "properties": {
        "front": {
          "$ref": "#/$defs/text"
        },
        "back": {
          "$ref": "#/$defs/text"
        },
        "back_formula": {
          "type": "object",
          "description": "Maths flashcards: the back as a formula the maths engine can read (x = ..., +- for ±, sqrt, ^), plus any conditions that must be stated (for example \"a ≠ 0\"). The blind answer is compared with the maths engine and must mention every condition (docs/VERIFICATION.md step 3).",
          "required": ["formula"],
          "properties": {
            "formula": {
              "type": "string",
              "minLength": 3
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "extended_answer": {
      "required": ["prompt", "marks", "mark_scheme_ref"],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "marks": {
          "$ref": "#/$defs/marks"
        },
        "command_word": {
          "$ref": "#/$defs/text"
        },
        "exemplars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Exemplar answers written from the mark scheme with their intended levels (top, middle and low band). A model from a different provider marks them blind (check: blind-marking, docs/VERIFICATION.md section 3). Not shown to students.",
          "items": {
            "type": "object",
            "required": ["band", "level", "answer"],
            "properties": {
              "band": {
                "enum": ["top", "middle", "low"]
              },
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
